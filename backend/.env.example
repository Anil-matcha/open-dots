BOAT_BASE_URL=https://boat.dev/api/v1
# Required for sandbox tasks; local API/web development can start without it.
BOAT_API_KEY=
# Required if your API key belongs to a personal account that also has an
# org/team on a paid plan -- sandbox creation bills to the personal account
# (and 402s) unless the org is attached here. Find the id via `box org list`
# or the Boat dashboard.
BOAT_ORG_ID=

POSTGRES_USER=vadoo
POSTGRES_PASSWORD=vadoo
POSTGRES_DB=vadoo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# scripts/dev.sh generates and saves this key if missing; keep it between runs.
# For manual setup, generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=

# From @BotFather on Telegram. Without it, scripts/dev.sh skips the bot.
TELEGRAM_BOT_TOKEN=
# Your bot's @username (without the @), shown to web UI users as a clickable
# link. Purely cosmetic.
TELEGRAM_BOT_USERNAME=

# Origin(s) allowed to call this API from a browser, comma-separated.
FRONTEND_ORIGINS=http://localhost:3000

# scripts/dev.sh replaces this example with a persistent random webhook secret.
# For manual setup: python -c "import secrets; print(secrets.token_urlsafe(32))"
HOOK_TOKEN=your-secret-token-here
# Set to your public backend/tunnel URL when using sandbox permission callbacks.
PERMISSION_HOOK_BASE_URL=your-public-url-here
